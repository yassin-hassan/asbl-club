// Cloudflare Worker with static assets: the Angular build is the site; worker/index.ts proxies /api/* to Spring
// and adds link previews to /events/:id.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asbl-club",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist/frontend/browser",
    "binding": "ASSETS",
    // Paths that aren't files (Angular routes like /asbls/x/members) get index.html.
    "not_found_handling": "single-page-application",
    // Only these go through the Worker: the API (proxied to Spring) and public event pages (link previews).
    // Everything else, the app's files, comes straight from the CDN (free, unlimited).
    "run_worker_first": ["/api/*", "/events/*"]
  },
  "vars": {
    // Where the Spring API runs (Render).
    "API_ORIGIN": "https://asbl-club.onrender.com"
  },
  "secrets": {
    // Shared with the API (EDGE_PROXY_SECRET there too). Set with `npx wrangler secret put EDGE_PROXY_SECRET`;
    // locally in .dev.vars (not committed).
    "required": ["EDGE_PROXY_SECRET"]
  }
}
